{
  "name": "@gyeonghokim/ky-digest-auth",
  "version": "0.1.0",
  "description": "HTTP Digest Authentication for Ky. Built for CCTV, NVR, and other embedded devices.",
  "keywords": [
    "ky",
    "digest",
    "digest-auth",
    "http-digest",
    "authentication",
    "www-authenticate",
    "cctv",
    "nvr",
    "fetch"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "biome check --write",
    "check:ci": "biome ci .",
    "format": "biome format --write",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  },
  "peerDependencies": {
    "ky": ">=1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "ky": "^2.0.2",
    "lint-staged": "^17.0.8",
    "msw": "^2.15.0",
    "semantic-release": "^25.0.6",
    "tsdown": "^0.22.7",
    "typescript": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "lint-staged": {
    "*.{ts,js,json,jsonc,md}": "biome check --write --no-errors-on-unmatched"
  },
  "license": "MIT",
  "author": "Gyeongho Kim <rlarudgh2017@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GyeongHoKim/ky-digest-auth.git"
  },
  "bugs": {
    "url": "https://github.com/GyeongHoKim/ky-digest-auth/issues"
  },
  "homepage": "https://github.com/GyeongHoKim/ky-digest-auth#readme"
}
